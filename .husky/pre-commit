# 1. Block direct commits to the protected branch (RULES.md §6).
branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
if [ "$branch" = "main" ]; then
  echo ""
  echo "  Direct commits to 'main' are blocked (RULES.md §6)."
  echo "  Create a branch first:  git checkout -b <type>/<short-description>"
  echo ""
  exit 1
fi

# 2. Lint and format only the staged files (fast).
pnpm exec lint-staged
