{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lumos",
  "version": "0.1.0",
  "identifier": "com.khan6.lumos",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && pnpm package:daemon",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lumos",
        "width": 1100,
        "height": 720,
        "minWidth": 860,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../../.lumos-daemon-runtime-build/": "daemon-runtime/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
